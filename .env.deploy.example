# =============================================================================
# Company Brain — VPS test deployment environment
# -----------------------------------------------------------------------------
# Copy to .env at the repo root and fill in the values below:
#     cp .env.deploy.example .env
#
# The deploy compose file overrides all INTERNAL hostnames (postgres, redis,
# qdrant, minio, temporal) automatically — you only set secrets and public URLs
# here. Generate secrets with:
#     openssl rand -hex 32     # for JWT/cookie secrets and TOKEN_ENCRYPTION_KEY
#     openssl rand -base64 24  # for passwords
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ── Public URLs (change to your VPS domain / IP) ─────────────────────────────
# What the BROWSER uses to reach the API. Baked into the web bundle at build
# time, so if you change it you must rebuild the web image.
PUBLIC_API_URL=http://YOUR_VPS_IP:4000
# Where the dashboard is served. Used for OAuth redirects + CORS.
WEB_APP_URL=http://YOUR_VPS_IP:3000
API_CORS_ORIGINS=http://YOUR_VPS_IP:3000
# Host ports published by compose (behind a reverse proxy in real deployments).
API_PORT=4000
WEB_PORT=3000

# ── Datastore credentials (used by both the DB container and the app) ────────
POSTGRES_PASSWORD=change-me-strong-db-password
STORAGE_ACCESS_KEY=change-me-minio-access-key
STORAGE_SECRET_KEY=change-me-minio-secret-key
STORAGE_DEFAULT_BUCKET=company-brain

# ── App secrets (REQUIRED — the API refuses to boot without these) ───────────
JWT_ACCESS_SECRET=change-me-min-32-chars-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-min-32-chars-openssl-rand-hex-32
COOKIE_SECRET=change-me-min-32-chars-openssl-rand-hex-32
# 64 hex chars — encrypts stored Google refresh tokens. Required for connectors.
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars-openssl-rand-hex-32

# ── Google Workspace OAuth (sign-in + connectors) ────────────────────────────
# Create an OAuth client in Google Cloud Console; the redirect URI must EXACTLY
# match GOOGLE_REDIRECT_URI below and be added to the client's authorized list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://YOUR_VPS_IP:4000/api/v1/auth/google/callback

# ── LLM / embeddings (Ask Brain + knowledge extraction) ──────────────────────
# 'codex' is keyless if available; otherwise use 'anthropic' with a key.
EXTRACTION_PROVIDER=codex
ANSWER_PROVIDER=codex
ANTHROPIC_API_KEY=
# 'local' embeddings need no key and run in-process (fine for a test deploy).
EMBEDDINGS_PROVIDER=local

# ── Ask Brain web search (keyless default) ───────────────────────────────────
WEB_SEARCH_PROVIDER=duckduckgo

# ── Meeting capture (optional) ───────────────────────────────────────────────
# Leave blank to disable Recall.ai capture; the app boots fine without it.
RECALLAI_KEY=
RECALL_WEBHOOK_SECRET=
MEETING_INTERNAL_TOKEN=change-me-meeting-internal-token
